#!/usr/bin/env bash
# Activate the Nix flake for this project via direnv, with private input support.
#
# Safe for non-Nix users: skips silently when `nix` is unavailable.
# Set `DIRENV_DISABLE_NIX=1` to opt out without uninstalling Nix.

# === Nix Flake ===
if [ -n "${DIRENV_DISABLE_NIX:-}" ]; then
  log_status "DIRENV_DISABLE_NIX set; skipping Nix flake activation."
elif has nix; then
  if [ -z "${DIRENV_DISABLE_NIX_GITHUB_TOKEN:-}" ]; then
    log_status "DIRENV_DISABLE_NIX_GITHUB_TOKEN set; skipping GitHub token bootstrapping."
  elif printf '%s\n' "${NIX_CONFIG:-}" | grep -qE '^\s*access-tokens\s*=\s*github\.com='; then
    log_status "NIX_CONFIG already contains GitHub token configuration; skipping token bootstrapping."
  elif [ -z "${GITHUB_TOKEN:-}" ]; then
    log_status "Bootstrapping GitHub token for private flake access..."

    if has gh; then
      gh_cli=(gh)
    else
      gh_cli=(nix run nixpkgs#gh --)
    fi

    # Fast path -- try to get the token without invoking `gh auth status` first, which can be slow.
    _GH_TOKEN="$("${gh_cli[@]}" auth token 2>/dev/null || true)"
    # Slow path -- only runs when fast path returned nothing
    if [ -z "${_GH_TOKEN:-}" ]; then
      "${gh_cli[@]}" auth status >/dev/null 2>&1 || { [ -t 0 ] && "${gh_cli[@]}" auth login; }
      _GH_TOKEN="$("${gh_cli[@]}" auth token 2>/dev/null || true)"
    fi
  else
    log_status "GITHUB_TOKEN already set in environment; skipping token bootstrapping."
    _GH_TOKEN="$GITHUB_TOKEN"
  fi

  # Check if the branches above have successfully found a token.
  if [ -n "${_GH_TOKEN:-}" ]; then
    log_status "Exporting GitHub token to NIX_CONFIG for flake access."
    NIX_CONFIG="${NIX_CONFIG:+${NIX_CONFIG} }access-tokens = github.com=${_GH_TOKEN}"
    export NIX_CONFIG
    unset _GH_TOKEN
  else
    log_status "No GitHub token available; private flake inputs may not resolve."
  fi

  # Activate the flake devshell. Respects custom devshell name overrides.
  use flake "${NIX_DEVSHELL_NAME:+.#${NIX_DEVSHELL_NAME}}"
else
  log_status "Nix is not installed; skipping flake activation."
fi

# === Virtual environment ===
VIRTUAL_ENV="$(pwd)/.venv"
PATH_add "$VIRTUAL_ENV/bin"
export VIRTUAL_ENV

# === Watchers ===
watch_file pyproject.toml ./*.lock

# === Dotenv ===
dotenv_if_exists .env
dotenv_if_exists .env.local

# === CA Certificates ===
if [ -z "${SSL_CERT_FILE:-}" ]; then
  if [ -f /etc/ssl/certs/ca-certificates.crt ]; then
    export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
  elif [ -f /etc/ssl/certs/ca-bundle.crt ]; then
    export SSL_CERT_FILE=/etc/ssl/certs/ca-bundle.crt
  fi
fi
