#!/usr/bin/env bash
# Activate the Nix flake's default devshell via direnv. Override by
# setting NIX_DEVSHELL_NAME (e.g. "cpu", "cu126", "cu129") before
# `direnv allow` or `direnv reload`.

if has nix; then
  use flake "${NIX_DEVSHELL_NAME:+.#${NIX_DEVSHELL_NAME}}"
fi

PATH_add "$VIRTUAL_ENV/bin"
